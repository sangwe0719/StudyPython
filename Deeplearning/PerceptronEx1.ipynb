   "source": [
    "import numpy as np\n",
    "def myNN(x):\n",
    " W = np.array([0.4, -0.1, 0.5])\n",
    " b = -0.5\n",
    " seta = 0\n",
    "\n",
    " v = np.sum(x * W) + b\n",
    " y = 1 if v>seta else 0\n",
    " return y\n",
    "ds = np.array([[0.3,0.1,0.8],\n",
    " [0.5,0.6,0.3],\n",
    " [0.1,0.2,0.1],\n",
    " [0.8,0.7,0.7],\n",
    " [0.5,0.5,0.6]])\n",
    "for i in range(5):\n",
    " print(myNN(ds[i,:]))"
   ]
  }
 ],
