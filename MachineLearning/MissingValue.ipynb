   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({'A': [1, None, 3], 'B': [4, 5, None]})\n",
    "\n",
    "df\n",
    "df.isnull().sum()        # 결측 개수 확인\n",
    "df.dropna()              # 제거\n",
    "df.fillna(df.mean())     # 평균으로 대체\n",
    "df.fillna(method='ffill') # 앞값으로 채우기"
   ]
  }
